# Copy to .env.deploy for Docker Compose. Never add API keys to a public deployment.
DATA_BI_ENV=production
DATA_BI_CORS_ORIGINS=http://localhost:8080
DATA_BI_MAX_UPLOAD_MB=100
DATA_BI_AUTH_REQUIRED=true
DATA_BI_AUTH_COOKIE_SECURE=false
DATA_BI_AUTH_SECRET=replace-with-a-32-character-or-longer-random-secret
DATA_BI_ADMIN_EMAIL=admin@example.com
DATA_BI_ADMIN_PASSWORD=replace-with-a-12-character-or-longer-password
# Leave all Riot variables unset until a Production Key is approved.
RIOT_ENABLE_PUBLIC_DATA=false
DATA_BI_PUUID_PEPPER=replace-with-a-long-random-secret
